# Soul Mesh — N05 peer topology
SOUL_MESH_TOKEN=your_mesh_token
SOUL_MESH_HMAC_SECRET=your_mesh_hmac_secret
SOUL_MESH_N01_URL=http://localhost:8080
SOUL_MESH_N02_URL=http://localhost:3000
SOUL_MESH_N03_URL=http://localhost:3002
SOUL_MESH_N04_URL=http://localhost:3003
SOUL_MESH_N05_URL=http://localhost:3004
SOUL_MESH_N06_URL=http://localhost:3005
